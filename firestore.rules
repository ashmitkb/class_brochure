rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, replacing
// the default. It allows anyone to read AND write documents in
// studentEdits — matching how the self-edit login already works (a
// shared password checked in the browser, not real per-user auth), so
// this doesn't pretend to be more secure than that. Firestore has no way
// to verify "is this really the student with this email" without wiring
// up actual Firebase Authentication, which would be the real next step
// if unauthorized edits ever become a problem in practice.
service cloud.firestore {
  match /databases/{database}/documents {
    match /studentEdits/{studentId} {
      allow read: if true;
      allow write: if true;
    }
    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
